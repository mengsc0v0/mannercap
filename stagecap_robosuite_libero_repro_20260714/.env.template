# Copy this file to `.env` and fill in local values before running experiments.

# Repository runtime
PYTHONPATH=.
MUJOCO_GL=egl
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
CUDA_VISIBLE_DEVICES=0

# Tested local Python on the original machine. Collaborators can replace this
# with their own virtualenv Python.
PYTHON_BIN=/path/to/your/venv/bin/python

# MIMO / OpenAI-compatible model endpoint used for stage planning and code generation.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=YOUR_OPENAI_COMPATIBLE_API_KEY
MIMO_MODEL=mimo-v2.5

# Optional point-prompt VLM backend. In our setup this can reuse the MIMO endpoint.
MOLMO_BASE_URL=${MIMO_BASE_URL}
MOLMO_API_KEY=${MIMO_API_KEY}
MOLMO_MODEL=mimo-v2.5

# Optional perception services.
SAM3_SERVICE_URL=http://127.0.0.1:8114
PYROKI_SERVICE_URL=http://127.0.0.1:8116
GRASPNET_SERVICE_URL=http://127.0.0.1:8115

# Default experiment knobs.
ROUND_TIMEOUT_SEC=1200
FEEDBACK_ROUNDS=2
TOTAL_TRIALS=1
NUM_WORKERS=1
MAX_TOTAL_STAGE_ATTEMPTS=10

# SSH tunnel proxy (18110 mapped from local 7897 via Real2Sim-Docker)
http_proxy=http://127.0.0.1:18110
https_proxy=http://127.0.0.1:18110
no_proxy=localhost,127.0.0.1,::1
